# Send every visitor to https://jameshagens.com (no "Not secure" warning, one URL for Google).
# Safe behind Cloudflare: a visit that reached Cloudflare over HTTPS is never redirected again,
# whatever SSL mode Cloudflare uses to talk to this server.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://jameshagens.com%{REQUEST_URI} [L,R=301]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://jameshagens.com%{REQUEST_URI} [L,R=301]
</IfModule>

ErrorDocument 404 /404.html
